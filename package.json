{
  "name": "doorcloud-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp",
      "@tensorflow/tfjs-node"
    ]
  },
  "description": "DoorCloud monorepo root (orchestrator)",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test:local": "pnpm -r test:local",
    "test:ci": "pnpm -r test:ci",
    "test:mqtt": "pnpm --filter @doorcloud/backend test:mqtt",
    "models:test": "tsx scripts/test-onnx-inference.ts",
    "benchmark:embeddings": "tsx scripts/embed-bfw.ts",
    "benchmark:analyze": "NODE_OPTIONS=--max-old-space-size=4096 tsx scripts/analyze-bias.ts",
    "benchmark:plots": ".venv/bin/python3 scripts/plot-bias-analysis.py",
    "benchmark:plots-benchmark": ".venv/bin/python3 scripts/histogram_for_metrics.py",
    "release": "commit-and-tag-version"
  },
  "license": "MIT",
  "devDependencies": {
    "commit-and-tag-version": "^12.6.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vladmandic/human": "^3.0.3",
    "dotenv": "^16.0.3",
    "fastify": "^5.10.0",
    "onnxruntime-node": "^1.17.0",
    "sharp": "^0.33.0",
    "yargs": "^17.7.3"
  },
  "engines": {
    "node": ">=22.20.0 <23",
    "pnpm": ">=10.30.1 <11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnthonyLzq/DoorCloud-backend.git"
  },
  "bugs": {
    "url": "https://github.com/AnthonyLzq/DoorCloud-backend/issues"
  },
  "homepage": "https://github.com/AnthonyLzq/DoorCloud-backend#readme",
  "commit-and-tag-version": {
    "skip": {
      "tag": true,
      "commit": true,
      "bump": true
    }
  }
}
