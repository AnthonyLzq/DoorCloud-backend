{
  "name": "@doorcloud/backend",
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.1",
  "main": "src/index.ts",
  "description": "Backend for DoorCloud",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nodemon --exitcrash",
    "lint": "biome check src/ bin/",
    "lint:fix": "biome check --write src/ bin/",
    "format": "biome format --write src/ bin/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "models:download": "./scripts/download-models.sh",
    "models:download:prod": "tsx scripts/download-models.prod.ts",
    "photos:backup": "tsx bin/door-cloud.ts backup",
    "preservice": "node scripts/ensure-services.mjs && node scripts/openwa/sync-api-key.mjs --optional",
    "service": "nodemon --exitcrash",
    "start": "NODE_PATH=dist node dist/index.js",
    "test:local": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:ci": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:mqtt": "scripts/mosquitto/run-integration-tests.sh",
    "test:mqtt:integration": "vitest run test/mqtt.integration.test.ts",
    "openwa:qr": "node scripts/openwa/qr-sign-in.mjs",
    "openwa:sync-api-key": "node scripts/openwa/sync-api-key.mjs",
    "pub": "nodemon --exec \"DEBUG=DoorCloud:* tsx -r dotenv/config src/pub.ts\"",
    "door-cloud": "tsx bin/door-cloud.ts",
    "test:integration": "vitest run test/python-manager-ipc.integration.test.ts test/python-manager-models.integration.test.ts test/onnx-provider.integration.test.ts"
  },
  "author": "AnthonyLzq <sluzquinosa@uni.pe>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/debug": "^4.1.7",
    "@types/http-errors": "^2.0.1",
    "@types/node": "^22.20.1",
    "@types/yargs": "^17.0.35",
    "dotenv": "^16.0.3",
    "nodemon": "^2.0.20",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^8.3.0",
    "@doorcloud/shared": "workspace:*",
    "@tensorflow/tfjs-node": "4.10.0",
    "@vladmandic/human": "^3.0.3",
    "debug": "^4.3.4",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "http-errors": "^2.0.0",
    "mqtt": "^5.15.2",
    "onnxruntime-node": "^1.17.0",
    "pino-pretty": "^9.1.1",
    "sharp": "^0.33.0",
    "yargs": "^17.7.3",
    "zod": "^4.4.3"
  },
  "nodemonConfig": {
    "watch": [
      ".env",
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "src/**/*.test.ts"
    ],
    "exec": "DEBUG=DoorCloud:* tsx -r dotenv/config ./src/index.ts"
  },
  "engines": {
    "node": ">=22.20.0 <23",
    "pnpm": ">=10.30.1 <11"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnthonyLzq/DoorCloud-backend.git"
  },
  "keywords": [
    "mqqt"
  ],
  "bugs": {
    "url": "https://github.com/AnthonyLzq/DoorCloud-backend/issues"
  },
  "homepage": "https://github.com/AnthonyLzq/DoorCloud-backend#readme",
  "bin": {
    "door-cloud": "bin/door-cloud.ts"
  }
}
