NODE_ENV=development
PORT=1996
# Bind address (default 0.0.0.0 so Docker services like OpenWA can reach the API)
HOST=0.0.0.0
# CORS_ORIGINS=http://localhost:3000,https://app.doorcloud.com

MQTT_USER=
MQTT_PASS=
# Credentials for the `door-cloud photos:send` CLI. It publishes as a device:
# the mosquitto ACL only lets the device user write doorcloud/v1/photo/send
# (see infra/mosquitto/aclfile). Defaults match
# scripts/mosquitto/create-password-file.sh.
MQTT_DEVICE_USER=doorcloud-device
MQTT_DEVICE_PASS=doorcloud-device-local
MQTT_HOST=
MQTT_PROTOCOL=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=
MQTT_CLEAN=true
MQTT_KEEPALIVE=60
MQTT_RECONNECT_PERIOD=1000
MQTT_CONNECT_TIMEOUT=30000
MQTT_QOS=0

# Local photo storage (replaces Supabase photos bucket).
# PHOTOS_BASE_URL must be reachable by the OpenWA Docker container too:
# `localhost` only works when OpenWA runs on the host; in Docker use the
# compose network gateway (e.g. http://172.18.0.1:1996/photos) or the host LAN IP.
PHOTOS_DIR=/var/lib/doorcloud/photos
PHOTOS_BASE_URL=http://localhost:1996/photos
PHOTOS_URL_SECRET=replace-with-a-long-random-string # signs photo URLs; replace it!
# How long signed photo URLs stay valid. Must cover the OpenWA media fetch
# window (reconnect, queueing); 300000 = 5 minutes.
PHOTO_URL_TTL_MS=300000
# SQLite app state path (optional; defaults to ./data/app-state.db). Set it to
# a mounted volume in Docker so last_message_at survives container recreation.
STATE_DB_PATH=

# Single local user (replaces Supabase users table)
USER_NAME=Ana
# Optional: destination WhatsApp chat (e.g. 51999999999@c.us). When unset,
# OPENWA_CHAT_ID (settable from the /setup page) is used for sends.
USER_PHONE=

# Backup CLI (pnpm photos:backup) — optional, only needed to run backups
BACKUP_DEST=/var/backups/doorcloud-photos
BACKUP_SECRET=your-webhook-secret

OPENWA_BASE_URL=http://localhost:2785
OPENWA_COMPOSE_SERVICE=openwa
OPENWA_API_KEY=
OPENWA_SESSION_ID=main
OPENWA_CHAT_ID=51999999999@c.us
# Comma-separated hosts OpenWA may fetch (its SSRF guard blocks private IPs).
# When PHOTOS_BASE_URL points at the host via the compose gateway (e.g.
# http://172.18.0.1:1996/photos), list that gateway here so OpenWA can fetch
# photo URLs to send via WhatsApp. Empty when PHOTOS_BASE_URL is public.
OPENWA_SSRF_ALLOWED_HOSTS=

SETUP_TOKEN=

MODELS_CDN_URL=

# Face verification (Buffalo-S ONNX pipeline)
FACE_VERIFY_THRESHOLD=0.3435
FACE_VERIFY_MAX_PHOTOS=10
